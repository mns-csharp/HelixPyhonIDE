BEGIN MoveDirectory: src/lib_core -> lib_core
DONE MoveDirectory: src/lib_core -> lib_core
BEGIN MoveDirectory: src/lib_utils -> lib_utils
DONE MoveDirectory: src/lib_utils -> lib_utils
BEGIN RewriteManifest: pyproject.toml
DONE RewriteManifest: pyproject.toml
BEGIN DeleteEmptyDirectory: src
DONE DeleteEmptyDirectory: src
