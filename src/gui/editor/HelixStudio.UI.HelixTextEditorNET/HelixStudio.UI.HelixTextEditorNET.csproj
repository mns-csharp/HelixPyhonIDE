<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <!-- In-house managed editor with its own namespace and assembly identity. -->
    <RootNamespace>HelixTextEditorNET</RootNamespace>
    <AssemblyName>HelixStudio.UI.HelixTextEditorNET</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <!-- TestEnvironment: the popups stay invisible in a test run (book Chapter 4, 4.6.5). -->
    <ProjectReference Include="$(RepositoryRoot)src\non-gui\foundation\HelixStudio.Core\HelixStudio.Core.csproj" />
  </ItemGroup>
</Project>
