  <ItemGroup>
    <Content Include="$(RepositoryRoot)assets\product\caption\*.png">
      <Link>assets\product\caption\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(RepositoryRoot)assets\product\toolbar\*.png">
      <Link>assets\product\toolbar\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(RepositoryRoot)assets\product\toolbox\*.png">
      <Link>assets\product\toolbox\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- The Solution Explorer's project-kind and tree icons. These were the one asset family
         NOT copied to the output, so a deployed build (no repository above the exe for
         ToolbarIconDiskLoader to fall back to) failed to open a solution with "Could not locate
         asset 'app_I.png'". Both .png and .ico live here. -->
    <Content Include="$(RepositoryRoot)assets\product\app\*.png;$(RepositoryRoot)assets\product\app\*.ico">
      <Link>assets\product\app\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(RepositoryRoot)assets\product\tree\*.png;$(RepositoryRoot)assets\product\tree\*.ico">
      <Link>assets\product\tree\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(RepositoryRoot)assets\product\banner\helixpython-ide-banner.png">
      <Link>assets\product\banner\helixpython-ide-banner.png</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(RepositoryRoot)assets\product\app\tab_close.ico">
      <LogicalName>HelixStudio.App.tab_close.ico</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <Target Name="PublishHelixPythonTerminal" BeforeTargets="Build">
    <MSBuild Projects="$(MSBuildProjectDirectory)\..\HelixStudio.Terminal\HelixStudio.Terminal.csproj"
             Targets="Restore;Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x64;SelfContained=true;PublishSingleFile=true;IncludeNativeLibrariesForSelfExtract=true;EnableCompressionInSingleFile=true;PublishDir=$(TargetDir)" />
  </Target>
  <!-- Copy pdebug.exe next to HelixStudio.exe after PythonDebugger has built. The
       Debugger library locates the executable at runtime via AppDomain.BaseDirectory. -->
  <Target Name="CopyPdebug" AfterTargets="Build">
    <ItemGroup>
      <PdebugArtifact Include="$(RepositoryRoot)..\PythonDebugger\bin\$(Configuration)\net472\pdebug.exe" />
      <PdebugArtifact Include="$(RepositoryRoot)..\PythonDebugger\bin\$(Configuration)\net472\pdebug.exe.config" />
      <PdebugArtifact Include="$(RepositoryRoot)..\PythonDebugger\bin\$(Configuration)\net472\Newtonsoft.Json.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(PdebugArtifact)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" Condition="Exists('%(PdebugArtifact.Identity)')" />
  </Target>
