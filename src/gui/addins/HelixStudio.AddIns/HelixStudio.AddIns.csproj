<Project Sdk="Microsoft.NET.Sdk">
  <!-- The add-in SDK: the contract an add-in implements (IHelixAddIn) and calls (IAddInHost),
       plus the designer kit that the shell and every design canvas share. It sits beside
       HelixPython.exe, so an add-in in addins\<Name>\ binds to the same copy as the shell. -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>HelixPythonNamespace.AddIns</RootNamespace>
    <AssemblyName>HelixStudio.AddIns</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Version>1.0.0</Version>
    <Product>HelixPython</Product>
    <Description>HelixPython add-in SDK: the add-in contract and the shared designer kit.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(RepositoryRoot)src\gui\shared\ToolbarIconDiskLoader.cs">
      <Link>Shared\ToolbarIconDiskLoader.cs</Link>
    </Compile>
    <ProjectReference Include="..\..\diagramming\HelixStudio.UI\HelixStudio.UI.csproj" />
    <!-- IAddInHost.SolutionTypes hands out the solution model (TypeModel), which is platform. -->
    <ProjectReference Include="..\..\..\non-gui\foundation\HelixStudio.Core\HelixStudio.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>
</Project>
