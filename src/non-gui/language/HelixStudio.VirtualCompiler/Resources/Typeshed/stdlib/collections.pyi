# Stubs for the `collections` module.

from typing import Callable, Iterable, Iterator

class OrderedDict(dict):
    def __init__(self, *args: object, **kwargs: object) -> None: ...
    def move_to_end(self, key: object, last: bool = ...) -> None: ...
    def popitem(self, last: bool = ...) -> tuple: ...

class defaultdict(dict):
    default_factory: Callable
    def __init__(self, default_factory: Callable = ..., *args: object, **kwargs: object) -> None: ...

class deque(object):
    maxlen: int
    def __init__(self, iterable: Iterable = ..., maxlen: int = ...) -> None: ...
    def append(self, x: object) -> None: ...
    def appendleft(self, x: object) -> None: ...
    def pop(self) -> object: ...
    def popleft(self) -> object: ...
    def extend(self, iterable: Iterable) -> None: ...
    def extendleft(self, iterable: Iterable) -> None: ...
    def rotate(self, n: int = ...) -> None: ...
    def clear(self) -> None: ...
    def __iter__(self) -> Iterator: ...
    def __len__(self) -> int: ...

class Counter(dict):
    def __init__(self, iterable: Iterable = ..., **kwargs: object) -> None: ...
    def most_common(self, n: int = ...) -> list: ...
    def elements(self) -> Iterator: ...
    def subtract(self, iterable: Iterable = ...) -> None: ...
    def update(self, iterable: Iterable = ...) -> None: ...

class ChainMap(dict):
    def __init__(self, *maps: dict) -> None: ...
    def new_child(self, m: dict = ...) -> ChainMap: ...

def namedtuple(typename: str, field_names: object, *, rename: bool = ..., defaults: Iterable = ..., module: str = ...) -> type: ...
