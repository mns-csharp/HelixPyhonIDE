# Minimal curated stubs for CPython 3.12 builtins. This is NOT a complete
# typeshed clone — just the high-signal names that the virtual compiler uses
# for undefined-name suppression and (phase 3+) basic type inference. Expand
# as the type checker grows.

from typing import Any, Callable, Iterable, Iterator, Protocol, Sequence, TypeVar

_T = TypeVar("_T")
_K = TypeVar("_K")
_V = TypeVar("_V")

