# Minimal curated stubs for the `os` module. `os.path` would normally be its
# own sub-module; for phase-2 simplicity we only cover module-level names.

from typing import Iterator, Iterable

environ: dict
sep: str
linesep: str
pathsep: str
name: str
curdir: str
pardir: str
devnull: str

def getcwd() -> str: ...
def getcwdb() -> bytes: ...
def chdir(path: str) -> None: ...
def listdir(path: str = ...) -> list: ...
def mkdir(path: str, mode: int = ...) -> None: ...
def makedirs(name: str, mode: int = ..., exist_ok: bool = ...) -> None: ...
def rmdir(path: str) -> None: ...
def remove(path: str) -> None: ...
def rename(src: str, dst: str) -> None: ...
def replace(src: str, dst: str) -> None: ...
def walk(top: str, topdown: bool = ..., onerror: object = ..., followlinks: bool = ...) -> Iterator: ...
def getenv(key: str, default: str = ...) -> str: ...
def putenv(key: str, value: str) -> None: ...
def unsetenv(key: str) -> None: ...
def system(command: str) -> int: ...
def urandom(size: int) -> bytes: ...
def stat(path: str) -> object: ...
def lstat(path: str) -> object: ...

class PathLike:
    def __fspath__(self) -> str: ...
