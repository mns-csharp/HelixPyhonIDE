# Minimal curated stubs for the `typing` module (Python 3.12). Covers the
# high-signal names used by idiomatic Python code. Expanded in later phases.

class _SpecialForm:
    def __getitem__(self, parameters: object) -> object: ...

Any: _SpecialForm
ClassVar: _SpecialForm
Final: _SpecialForm
Literal: _SpecialForm
NoReturn: _SpecialForm
Never: _SpecialForm
Optional: _SpecialForm
Type: _SpecialForm
TypeAlias: _SpecialForm
TypeGuard: _SpecialForm
Union: _SpecialForm
Unpack: _SpecialForm
Required: _SpecialForm
NotRequired: _SpecialForm
Self: _SpecialForm
LiteralString: _SpecialForm
Concatenate: _SpecialForm
Annotated: _SpecialForm

TYPE_CHECKING: bool

class TypeVar:
    __name__: str
    __bound__: object
    __constraints__: tuple
    __covariant__: bool
    __contravariant__: bool
    __default__: object
    def has_default(self) -> bool: ...
    def __init__(self, name: str, *constraints: object, bound: object = ..., covariant: bool = ..., contravariant: bool = ...) -> None: ...

class ParamSpec:
    __name__: str
    def __init__(self, name: str, *, bound: object = ..., covariant: bool = ..., contravariant: bool = ...) -> None: ...

class TypeVarTuple:
    __name__: str
    def __init__(self, name: str) -> None: ...

class Generic:
    def __class_getitem__(cls, item: object) -> object: ...

class Protocol(Generic):
    def __class_getitem__(cls, item: object) -> object: ...

class NamedTuple:
    _fields: tuple
    def __init__(self, *args: object, **kwargs: object) -> None: ...

class TypedDict(dict):
    def __init__(self, *args: object, **kwargs: object) -> None: ...

def cast(typ: object, val: object) -> object: ...
def overload(func: object) -> object: ...
def final(f: object) -> object: ...
def runtime_checkable(cls: object) -> object: ...
def get_type_hints(obj: object, globalns: dict = ..., localns: dict = ..., include_extras: bool = ...) -> dict: ...
def get_args(tp: object) -> tuple: ...
def get_origin(tp: object) -> object: ...
def assert_type(val: object, typ: object) -> object: ...
def assert_never(arg: object) -> None: ...
def reveal_type(obj: object) -> object: ...

# Generic containers (re-exported from collections.abc in newer Python, but
# `typing.List` etc. still exist as aliases).
class Iterable:
    def __iter__(self) -> object: ...
class Iterator(Iterable):
    def __next__(self) -> object: ...
class AsyncIterable:
    def __aiter__(self) -> object: ...
class AsyncIterator(AsyncIterable):
    async def __anext__(self) -> object: ...
class Container:
    def __contains__(self, x: object) -> bool: ...
class Hashable:
    def __hash__(self) -> int: ...
class Sized:
    def __len__(self) -> int: ...
class Reversible(Iterable):
    def __reversed__(self) -> Iterator: ...
class Collection(Sized, Iterable, Container): ...
class Sequence(Reversible, Collection):
    def __getitem__(self, i: object) -> object: ...
    def count(self, x: object) -> int: ...
    def index(self, x: object) -> int: ...
class MutableSequence(Sequence):
    def append(self, x: object) -> None: ...
    def extend(self, xs: object) -> None: ...
class Mapping(Collection):
    def __getitem__(self, k: object) -> object: ...
    def __contains__(self, k: object) -> bool: ...
    def __iter__(self) -> Iterator: ...
    def __len__(self) -> int: ...
    def keys(self) -> object: ...
    def values(self) -> object: ...
    def items(self) -> object: ...
    def get(self, k: object, default: object = ...) -> object: ...
class MutableMapping(Mapping):
    def __setitem__(self, k: object, v: object) -> None: ...
    def __delitem__(self, k: object) -> None: ...
    def pop(self, k: object, default: object = ...) -> object: ...
    def popitem(self) -> object: ...
    def clear(self) -> None: ...
    def update(self, other: object = ..., **kwargs: object) -> None: ...
    def setdefault(self, k: object, default: object = ...) -> object: ...
# The read-only set ABC (collections.abc.Set / typing.AbstractSet). `typing.Set`
# itself is a deprecated alias for the mutable builtin `set` (see the alias block
# below), so the ABC keeps its distinct name and concrete containers inherit it.
class AbstractSet(Collection):
    def __contains__(self, x: object) -> bool: ...
class MutableSet(AbstractSet):
    def add(self, value: object) -> None: ...
    def discard(self, value: object) -> None: ...
    def remove(self, value: object) -> None: ...
    def pop(self) -> object: ...
    def clear(self) -> None: ...
class Callable:
    def __call__(self, *args: object, **kwargs: object) -> object: ...
class Awaitable:
    def __await__(self) -> object: ...
class Coroutine(Awaitable):
    def send(self, value: object) -> object: ...
class AsyncContextManager:
    async def __aenter__(self) -> object: ...
    async def __aexit__(self, exc_type: object, exc: object, tb: object) -> object: ...
class ContextManager:
    def __enter__(self) -> object: ...
    def __exit__(self, exc_type: object, exc: object, tb: object) -> object: ...

# Convenience generic aliases — still used widely in older code. `typing.Set` is
# a deprecated alias for the mutable builtin `set` (so `x: Set[int]` supports
# add/remove/discard); the read-only ABC lives above as `AbstractSet`.
List = list
Dict = dict
Tuple = tuple
Set = set
FrozenSet = frozenset
