<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Long-path support (Windows MAX_PATH is 260). Without these switches, net472's
    File/Directory APIs silently fail on >260-char paths, so a deeply-nested or
    long-named source file was dropped from ALL analysis (compile/lint/deadcode/
    metrics) — e.g. _t1_t7_validate_integer_cuda.py (path len 266) in fixture (a).
    UseLegacyPathHandling=false makes the BCL auto-prepend the \\?\ extended prefix
    for long paths; BlockLongPaths=false stops it throwing PathTooLongException.
    The OS must have LongPathsEnabled=1 (verified present on the build machine) and
    the process must be long-path-aware (see app.manifest).
  -->
  <runtime>
    <AppContextSwitchOverrides value="Switch.System.IO.UseLegacyPathHandling=false;Switch.System.IO.BlockLongPaths=false" />
  </runtime>
</configuration>
